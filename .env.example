# Public URL of the live site (canonical URLs, Open Graph, sitemap, robots.txt).
NEXT_PUBLIC_SITE_URL=https://agmanrajpurohit.vercel.app

# Contact details shown on the site. Change these when the final links are ready.
NEXT_PUBLIC_CONTACT_EMAIL=agmanpurohit@gmail.com
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/agmanpurohit

# Contact form delivery via Resend (https://resend.com, free tier is enough).
# 1. Create an account and an API key.
# 2. Until you verify your own domain, keep the default sender below; Resend will
#    deliver only to the email address your Resend account is registered with.
# Without RESEND_API_KEY and CONTACT_TO_EMAIL the form validates input but does not send;
# it tells visitors to email or WhatsApp you instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=agmanpurohit@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# ── SEO audit tool ──────────────────────────────────────────
# Neon Postgres (Neon → Connect → pooled connection string). Tables are created automatically.
DATABASE_URL=
# Google Cloud → enable "PageSpeed Insights API" → Credentials → API key.
PAGESPEED_API_KEY=
# Admin dashboard at /admin.
ADMIN_PASSWORD=
# 32+ random characters used to sign the admin cookie and hash IPs.
ADMIN_SESSION_SECRET=
# Email reports to visitors (requires a domain verified in Resend, then set CONTACT_FROM_EMAIL
# to an address on that domain). Until then reports go to CONTACT_TO_EMAIL and visitors download.
REPORT_SEND_TO_VISITOR=false
# Optional limits (defaults shown).
AUDIT_MAX_PAGES=100
AUDIT_MAX_DEPTH=4
AUDIT_CONCURRENCY=4
AUDIT_IP_DAILY_LIMIT=10
AUDIT_DOMAIN_HOURLY_LIMIT=3
